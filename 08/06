@RestController
@RequestMapping("/book")
public class BookController {

    @GetMapping("/list")
    public String list() {
        return "bookList";
    }

    @PostMapping("/detail")
    @ResponseBody
    public Book detail(@RequestParam int id) {
        return new Book(id, "스프링 입문");
    }
}
