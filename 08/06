// @RestController // 문제: 목록 조회 요청의 경우 "bookList" 값이 아니라 페이지 응답해줘야 함
@Controller
@RequestMapping("/book")
public class BookController {

    @GetMapping("/list")
    //public String list() {  // 문제: 목록 조회 시 요청 파라미터를 처리하지 않음!
    public String list(@RequestParam(defaultValue="") String title) {
        return "bookList";  // 기본적으로 포워드 처리되므로 bookList 라는 페이지가 응답
    }

    // @PostMapping("/detail") // 문제: 보통 조회 요청은 GET 방식을 사용함!
    @GetMapping("/detail")
    @ResponseBody
    public Book detail(@RequestParam int id) {
        return new Book(id, "스프링 입문");
    }
}
