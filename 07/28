### 변수와 상수

- let : 블록 스코프를 가지며, 재할당은 가능하지만 재선언은 불가능한 변수 선언 키워드
   let  변수명;   // 자바에서의 일반 변수와 유사

- const : 블록 스코프를 가지며, 선언과 동시에 초기화해야 하고 재할당과 재선언이 모두 불가능한 상수 선언 키워드
    const 변수명 = 값;  // 자바에서 final 키워드를 사용했을 때와 유사
 
- var : 함수 스코프를 가지며, 재선언과 재할당이 모두 가능하지만 변수 끌어올림(Hoisting) 현상으로 인해 현재는 사용을 지양하는 구버전 변수 선언 키워드
     var 변수명;

- 호이스팅 : 변수나 함수 선언문이 해당 스코프의 최상단으로 끌어올려진 것처럼 동작하는 자바스크립트 고유의 특징

- TDZ : let이나 const로 변수를 만들 때, 선언되고 나서 실제 값이 준비될 때까지 해당 변수를 참조하지 못하도록 막아두는 구역

### 데이터 타입과 연산자

- undefined : 기본 데이터 타입(Primitive Type) 중 값이 할당되지 않은 상태를 나타내는 타입

- null : 개발자가 의도적으로 '값이 없음'을 명시하기 위해 사용하는 데이터 타입 (object)

- typeof : 변수의 데이터 타입을 문자열 형태로 반환해 주는 연산자
       typeof 변수명 => 변수에 저장된 값의 데이터 타입을 반환
    typeof null = object

- === / !== : 피연산자의 값뿐만 아니라 데이터 타입까지 엄격하게 비교하는 일치 연산자
    => "10" == 10 // true
          "10" === 10 // false

- ?? : 앞의 값이 null이나 undefined일 때만 뒤에 있는 대체 값을 사용하도록 해주는 연산자 (null 병합 연산자)
   => 변수명 ?? 초기값   //  변수가 null 이거나 undefined 면 초기값을 사용

### 제어문과 함수

- if / else if / else : 조건식의 참/거짓에 따라 실행할 코드 블록을 결정하는 조건문
    if(조건식){
                 // 조건을 만족할 때 실행
}else if(조건식2){   // 
    }else { }

- for : 지정한 횟수만큼 반복 실행할 때 주로 사용하는 반복문
    for(초기식;조건식;증감식){  // 반복적으로 실행할 내용}
     
    for(키워드 변수명 of 배열){
                 // 변수명으로 배열 내 데이터에 접근
    }

    for(키워드 변수명 in 객체){
            // 변수명으로 객체 내 키값에 접근
    }
 
- 함수 : 자주 쓰는 코드들을 하나로 묶어 두고 필요할 때마다 불러와서 재사용할 수 있게 만든 코드 모음
    function 함수명([매개변수]){
             // 실행할 내용
    }
     
    const 변수명 = 익명함수
    => const 함수명 = function([매개변수]){
            // 실행할 내용
       }

- 화살표 함수 : function 키워드 대신 화살표(=>)를 사용하여 함수를 간결하게 정의하는 문법
           const 변수명 = 익명함수
    => const 함수명 = ([매개변수]) => {
            // 실행할 내용
       }
       // 중괄호 생략 가능 => 실행할 내용이 한 줄 일 경우
           const 함수명 =(매개변수) => 실행할 내용

- 스코프 : 변수를 선언했을 때 해당 변수를 사용할 수 있고 접근할 수 있는 유효한 범위
      변수 사용 시 접근 순서 :  현재 스코프 -> 상위 스코프 -> 전역 스코프( {}중괄호로 구분하면 됨)
